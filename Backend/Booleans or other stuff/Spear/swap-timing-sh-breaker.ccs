def module swap-timing-sh-breaker

on module_enable wait 0.1 {
    module disable swap-timing-sh-breaker
}

on module_enable wait 0.06666666 {
            module enable switch-cooldown-sh-b2
}

on tick if playing if module_enabled Spear-Reach if module_enabled sh-breaker-switch-cooldown-SR if module_disabled switch-cooldown-sh-b2 if module_disabled switch-cooldown-sh-b2 if module_disabled switch-cooldown-sh-b2 if module_disabled switch-cooldown-sh-b2 if module_disabled switch-cooldown-sh-b2 if module_disabled switch-cooldown-sh-b2 {
    if_not holding #_spear {
        if entity_in_range :player 4.8 if_not entity_in_range :player 3 {
            if entity_in_fov :player 40 {
                switch #_spear
                if module_enabled Stun {
                input attack
                }
            }
        }
    }

    if holding #_spear {
        if hotbar_has #sword if targeting_entity if attack_progress >= 0.05 {
            module disable swap-timing-sh-breaker
            switch #_axe
            input attack
        }
    }
}

on module disable if playing {
    if module_enabled Swap-To-Sword-SR wait 0.1 {
        switch #_sword
    }
}
// later adding this in, too much of a headache
def func invSwap {

    if module_enabled Axe-Swap-1 {
        gui_quickmove #_axe 1
    }

    if module_enabled Axe-Swap-2 {
        gui_quickmove #_axe 2
    }

    if module_enabled Axe-Swap-3 {
        gui_quickmove #_axe 3
    }

    if module_enabled Axe-Swap-4 {
        gui_quickmove #_axe 4
    }

    if module_enabled Axe-Swap-5 {
        gui_quickmove #_axe 5
    }

    if module_enabled Axe-Swap-6 {
        gui_quickmove #_axe 6
    }

    if module_enabled Axe-Swap-7 {
        gui_quickmove #_axe 7
    }

    if module_enabled Axe-Swap-8 {
        gui_quickmove #_axe 8
    }

    if module_enabled Axe-Swap-9 {
        gui_quickmove #_axe 9
    }

}
