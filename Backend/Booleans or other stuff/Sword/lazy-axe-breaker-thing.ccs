def module lazy-axe-breaker-thing

on module_enable if playing if module_enabled stunSlammer {
    module disable lazy-axe-breaker-thing
}

on module_enable if playing if module_disabled Swap-from-Inventory if module_disabled stunSlamPrioritized {
func tempFunc
}

on module_enable if playing if module_enabled Swap-from-Inventory if module_disabled stunSlamPrioritized if_not input_active inventory {

    if_not hotbar_has #_axe {
        if_not input_active inventory {
        input inventory
        }
        func invSwap
        wait 0.05 {
            if input_active inventory {
            input inventory
            }
            wait 0.05 {

            func tempFunc
            }
        }
    }

    if hotbar_has #_axe {
        func tempFunc
    }
}

def func tempFunc {
    as target_entity if blocking if entity_in_range :player 3.2 {
        if_not holding #_axe if_not holding #_axe if_not holding #_axe if_not holding #_axe if_not holding #_axe {  
    switch #_axe
        }

    input left
    }
}

def func spearFunc {
    as nearest_entity :player if blocking {

        if module enabled SR-On-Sword {
            module disable SR-On-Sword
            wait 0.1 {
                module enable SR-On-Sword
            }
        }

        if module enabled SR-On-Axe {
            module disable SR-On-Axe
            wait 0.1 {
                module enable SR-On-Axe
            }
        }

        if module enabled SR-On-Mace {
            module disable SR-On-Mace
            wait 0.1 {
                module enable SR-On-Mace
            }
        }
        if module_disabled swap-timing-sh-breaker {
        module enable swap-timing-sh-breaker
        }
    }
}

on module_enable {
    if module_disabled Automatic wait 0.01 {
        module disable lazy-axe-breaker-thing
    }
    if module_enabled Automatic wait 0.2 {
        module disable lazy-axe-breaker-thing
    }
}

def func invSwap {

    if module_enabled Axe-Swap-1 {
        gui_quickmove #_axe 1
    }

    if module_enabled Axe-Swap-2 {
        gui_quickmove #_axe 2
    }

    if module_enabled Axe-Swap-3 {
        gui_quickmove #_axe 3
    }

    if module_enabled Axe-Swap-4 {
        gui_quickmove #_axe 4
    }

    if module_enabled Axe-Swap-5 {
        gui_quickmove #_axe 5
    }

    if module_enabled Axe-Swap-6 {
        gui_quickmove #_axe 6
    }

    if module_enabled Axe-Swap-7 {
        gui_quickmove #_axe 7
    }

    if module_enabled Axe-Swap-8 {
        gui_quickmove #_axe 8
    }

    if module_enabled Axe-Swap-9 {
        gui_quickmove #_axe 9
    }

}
