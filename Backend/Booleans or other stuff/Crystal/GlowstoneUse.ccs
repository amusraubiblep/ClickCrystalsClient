def module glowstone-use-module

on module_enable if playing if module_disabled Airplace-Keybind {
if holding #glowstone {

    if module_enabled One-Tick-GS {
            input key P
    }

    if module_enabled Two-Tick-GS {
        wait 0.05 {
            input key P
        }
    }

    if module_enabled Three-Tick-GS {
        wait 0.1 {
            input key P
        }
    }
}
}

on module_enable if playing if module_disabled Airplace-Keybind if module_enabled Only-Placed-Anchors {
if holding #glowstone {

    if module_enabled One-Tick-GS {
        wait 0.05 {
            input key P
        }
    }

    if module_enabled Two-Tick-GS {
        wait 0.05 {
            input key P
        }
    }

    if module_enabled Three-Tick-GS {
        wait 0.1 {
            input key P
        }
    }
}
}


on key_press P {
    module disable glowstone-use-module
    if module_enabled Only-Placed-Anchors {
        module enable placedAnchorP2
    }
}