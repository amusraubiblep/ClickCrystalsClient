def module placedAnchorP2

on tick if playing if module_enabled Only-Placed-Anchors if module_disabled Anchor-Macro-While-Use {
    if target_block :charged_respawn_anchor {

        if module_enabled Air-Place if module_disabled Airplace-Macro {
            if holding #anchor {
                if input_active right {
                    hold_input key P 0.05
                }
            }
        }

        if module_enabled Totem-Swap {

            if module_enabled Air-Place {
                if_not holding #anchor {
                func TotemSwap
                }
            }

            if module_disabled Air-Place {
                func TotemSwap
            }

        }

        if module_enabled Explode-Anchor {
            module enable explode-use-module
        }
    }
    module disable placedAnchorP2
}

def func TotemSwap {

    if module_enabled Totem-Slot-1 {
        switch 1
    }

    if module_enabled Totem-Slot-2 {
        switch 2
    }

    if module_enabled Totem-Slot-3 {
        switch 3
    }

    if module_enabled Totem-Slot-4 {
        switch 4
    }

    if module_enabled Totem-Slot-5 {
        switch 5
    }

    if module_enabled Totem-Slot-6 {
        switch 6
    }

    if module_enabled Totem-Slot-7 {
        switch 7
    }

    if module_enabled Totem-Slot-8 {
        switch 8
    }

    if module_enabled Totem-Slot-9 {
        switch 9
    }

}