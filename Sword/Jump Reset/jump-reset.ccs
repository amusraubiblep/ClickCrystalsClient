def module Jump-Reset
def desc "Jumps upon taking an attack to reduce knockback"

on sound_play #entity.player.attack if playing if input_active forward {
    as nearest_entity :player if holding #sword,#axe {
        as target_entity if line_of_sight {
        as client if hurt_time > 0 {
            func jumpResetChance
            }
        }
    }
}

def func lateJumpReset {

    if module_enabled Late-Jump-Reset {
    wait_random 0.04 0.05666
    repeat 3 {
            input key space
        }
    }

    if module_disabled Late-Jump-Reset {
        func jumpReset
    }

}

def func jumpReset {
        repeat 3 {
            input key space
    }
}

def func jumpResetChance {

if module_enabled 85%-Chance-AJR {
    if chance_of 85 {
        execute_random {
            func lateJumpReset
            func lateJumpReset
            func jumpReset
            func jumpReset
            }
        }
    }

if module_enabled 50%-Chance-AJR {
    if chance_of 50 {
        execute_random {
            func lateJumpReset
            func lateJumpReset
            func jumpReset
            func jumpReset
            }
        }
    }

if module_enabled 25%-Chance-AJR {
    if chance_of 25 {
        execute_random {
            func lateJumpReset
            func lateJumpReset
            func jumpReset
            func jumpReset
            }
        }
    }
    
    }