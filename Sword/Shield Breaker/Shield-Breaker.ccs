def module Shield-Breaker
def desc "Disable Shield using axe"

on module_enable if module_disabled On-Keybind {
    module enable On-Hit
    module disable Stun-Web
    module disable Automatic
}

on left_click if playing if_not input_active attack if_not input_active use if module_enabled On-Hit if module_disabled Triggerbot {
    if target_entity :player {
        if hotbar_has #axe {
            if hotbar_has #sword {
                as target_entity if blocking {
                    if hotbar_has :cobweb if module_enabled Stun-Web {
                        func stunWeb
                    }

                    if module_disabled Stun-Web {
                        func swordStun
                        }

                    if_not hotbar_has :cobweb if module_enabled Stun-Web {
                        func swordStun
                    }

                    }
                }
            }
        }
    }

on left_click if playing if_not input_active attack if_not input_active use if module_enabled On-Hit if module_enabled Triggerbot {
    if target_entity :player {
        if hotbar_has #axe {
            if hotbar_has #sword {
                as target_entity if blocking {
                    if hotbar_has :cobweb if module_enabled Stun-Web {
                        func stunWeb
                    }

                    if module_disabled Stun-Web {
                        func swordStun
                        }

                    if_not hotbar_has :cobweb if module_enabled Stun-Web {
                        func swordStun
                    }

                    }
                }
            }
        }
    }

on module_enable while 0.004 module_enabled Shield-Breaker if playing if_not input_active attack if_not input_active use if module_enabled Automatic if module_disabled Triggerbot {
    if target_entity :player {
        if hotbar_has #axe {
            if hotbar_has #sword {
                as target_entity if blocking {
                    if hotbar_has :cobweb if module_enabled Stun-Web {
                        func stunWeb
                    }

                    if module_disabled Stun-Web {
                        func swordStunAutomatic
                    }

                    if_not hotbar_has :cobweb if module_enabled Stun-Web {
                        func swordStunAutomatic
                    }

                    }
                }
            }
        }
    }

on module_enable while 0.004 module_enabled Shield-Breaker if playing if_not input_active attack if_not input_active use if module_enabled Automatic if module_enabled Triggerbot {
    if target_entity :player {
        if_not holding #sword,#axe {
                as target_entity if blocking {
                    if hotbar_has :cobweb if module_enabled Stun-Web {
                        func stunWeb
                    }

                    if module_disabled Stun-Web {
                        func swordStunAutomatic
                    }

                    if_not hotbar_has :cobweb if module_enabled Stun-Web {
                        func swordStunAutomatic
                    }

                    }
                }
            }
        }
    

on left_click if playing if_not input_active attack if_not input_active use if module_enabled Automatic if module_enabled Triggerbot {
    if target_entity :player {
        if hotbar_has #axe {
            if hotbar_has #sword {
                as target_entity if blocking {
                    if hotbar_has :cobweb if module_enabled Stun-Web {
                        func stunWeb
                    }

                    if module_disabled Stun-Web {
                        func swordStun
                        }

                    if_not hotbar_has :cobweb if module_enabled Stun-Web {
                        func swordStun
                    }

                    }
                }
            }
        }
    }
 
def func stunWeb {
    if_not holding #_axe {
        switch #_axe
    }
    if holding #_axe {
    wait_random 0.162231 0.2
    input left
    }
}

def func swordStun {
    if_not holding #_axe {
        switch #_axe
    }
    if holding #_axe {
    wait_random 0.162231 0.2 
    func isSwapBack
    input left
    }
}



on sound_play #shield_break if playing if hotbar_has :cobweb if module_enabled Stun-Web {
    if holding #axe {
        as target_entity if_not block_in_range :cobweb 2 {
        module enable cobweb-placer
        }
    }
}

def func swordStunAutomatic {
    if_not holding #_axe {
        switch #_axe
    }
    as target_entity if blocking { 
         if holding #_axe {
            input left
            wait_random 0.162231 0.2 {
                func isSwapBack
            }
        }
    }
}

def func isSwapBack {

    if module_disabled Swap-Back {
        switch #sword
    }

    if module_enabled Swap-Back {
        switch back
    }

}