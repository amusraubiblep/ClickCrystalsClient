def module cobweb-placer
def desc "can work as a standalone or with stunweb, bind if using it to place cobwebs"

on module_enable while 0.004 module_enabled cobweb-placer if hotbar_has :cobweb {
    if playing {
        if_not holding :cobweb {
            if targeting_block if_not input_active use {
            switch :cobweb
            input right
        }
    }
        if holding :cobweb {
            if targeting_block if_not input_active use {
                input right
            }
        }
    }
}

on module_enable if playing {
    wait 1.2 {
        if module_enabled cobweb-placer {
            module disable cobweb-placer
        }
    }
}

on place_block if playing if holding :cobweb {
    module disable cobweb-placer

    if module_enabled Cobweb-Swap-To-Sword {
        func isSwapback
    }

}

on module_disable if playing if module_enabled Cobweb-Swap-To-Sword {
    if holding :cobweb {
        func isSwapback
    }
}

def func isSwapback {

    if module_enabled Swap-Back {

        if module_enabled One-Tick-Swap {
            wait 0.05 {
        switch #sword
            }
        }

        if module_enabled Two-Tick-Swap {
            wait 0.10 {
                switch #sword
            }
        }

        if module_enabled Three-Tick-Swap {
            wait 0.15 {
                switch #sword
            }
        }

    }

}