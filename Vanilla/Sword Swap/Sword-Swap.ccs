def module Sword-Swap-KB
def desc "When you click, it swaps to your sword and swaps back for your swords knockback"

on left_click if playing if module_disabled On-Shield-SS if module_disabled On-Crystal-SS if module_disabled On-Totem-SS if target_entity :player {
    if module_enabled Double-Hand {
        module disable Double-Hand
        wait 0.05 {
            module enable Double-Hand
        }
    }

    switch #_sword
    wait 0.05 {
        switch back
    }
}

on left_click if playing if module_enabled On-Totem-SS if holding :totem_of_undying,:air if target_entity :player {
    if module_enabled Double-Hand {
        module disable Double-Hand
        wait 0.05 {
            module enable Double-Hand
        }
    }

    switch #_sword
    wait 0.05 {
        if hotbar_has :totem_of_undying {
        switch :totem_of_undying
        }
        if_not hotbar_has :totem_of_undying {
        func TotemSwap
        }
    }
}

on left_click if playing if module_enabled On-Crystal-SS if holding :end_crystal if target_entity :player {
    if module_enabled Double-Hand {
        module disable Double-Hand
        wait 0.05 {
            module enable Double-Hand
        }
    }

    switch #_sword
    wait 0.05 {
        if hotbar_has :end_crystal {
        switch :end_crystal
        }
    }
}

on left_click if playing if module_enabled On-Shield-SS if holding :shield if target_entity :player {
    if module_enabled Double-Hand {
        module disable Double-Hand
        wait 0.05 {
            module enable Double-Hand
        }
    }

    if input_active use {
    switch #_sword
    wait 0.025 {
    input key O
    wait 0.05 {
        if hotbar_has :shield {
        switch :shield
                }
            }
        }
    }

    
    if_not input_active use {
    switch #_sword
    wait 0.05 {
        if hotbar_has :shield {
        switch :shield
            }
        }
    }
}

def func TotemSwap {

    if module_enabled Auto-Totem-Slot-1 {
        switch 1
    }

    if module_enabled Auto-Totem-Slot-2 {
        switch 2
    }

    if module_enabled Auto-Totem-Slot-3 {
        switch 3
    }

    if module_enabled Auto-Totem-Slot-4 {
        switch 4
    }

    if module_enabled Auto-Totem-Slot-5 {
        switch 5
    }

    if module_enabled Auto-Totem-Slot-6 {
        switch 6
    }

    if module_enabled Auto-Totem-Slot-7 {
        switch 7
    }

    if module_enabled Auto-Totem-Slot-8 {
        switch 8
    }

    if module_enabled Auto-Totem-Slot-9 {
        switch 9
    }

}