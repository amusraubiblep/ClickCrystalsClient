def module Airplace-Keybind
def desc "Must have Airplace Macro on, set keybind here by right clicking on me"

on module_enable if playing if module_disabled Totem-Swap {
    if targeting_block {
        if hotbar_has #anchor {
            if hotbar_has #glowstone {
                if target_block :charged_respawn_anchor {
                    input key P
                }

                switch #anchor
                input key P
                wait 0.05 {
                    switch #glowstone
                    input key P
                    wait 0.05 {
                        switch #anchor
                        hold_input key P 0.1
                        wait 0.2 {
                            switch #glowstone
                            input key P
                            wait 0.05 {
                                func TotemSwap
                                input key P
                                module disable Airplace-Keybind
                            }
                        }
                    }
                }
            }
        }
    }
}

on module_enable if playing if module_enabled Totem-Swap {
    if targeting_block {
        if hotbar_has #anchor {
            if hotbar_has #glowstone {
                module disable Totem-Swap
                if target_block :charged_respawn_anchor {
                    input key P
                }

                switch #anchor
                input key P
                wait 0.05 {
                    switch #glowstone
                    input key P
                    wait 0.05 {
                        switch #anchor
                        hold_input key P 0.1
                        wait 0.2 {
                            switch #glowstone
                            input key P
                            wait 0.05 {
                                func TotemSwap
                                input key P
                                module disable Airplace-Keybind
                                module enable Totem-Swap
                            }
                        }
                    }
                }
            }
        }
    }
}

def func TotemSwap {

    if module_enabled Totem-Slot-1 {
        switch 1
    }

    if module_enabled Totem-Slot-2 {
        switch 2
    }

    if module_enabled Totem-Slot-3 {
        switch 3
    }

    if module_enabled Totem-Slot-4 {
        switch 4
    }

    if module_enabled Totem-Slot-5 {
        switch 5
    }

    if module_enabled Totem-Slot-6 {
        switch 6
    }

    if module_enabled Totem-Slot-7 {
        switch 7
    }

    if module_enabled Totem-Slot-8 {
        switch 8
    }

    if module_enabled Totem-Slot-9 {
        switch 9
    }

}