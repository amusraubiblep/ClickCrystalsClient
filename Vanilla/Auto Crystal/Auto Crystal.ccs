def module Auto-Crystal

on module_enable {
    module enable 15-CPS-AC
}

on pre_tick if module_enabled Auto-Crystal if playing if module_enabled Fast-Place-Vanilla {
    if module_enabled 20-CPS-AC {
        func doCrystal
    }
}

on module_enable while 0.06667 module_enabled Auto-Crystal if playing if module_enabled Fast-Place-Vanilla {
    if module_enabled 15-CPS-AC {
        func doCrystal
    }
}

on pre_tick 2 if module_enabled Auto-Crystal if playing if module_enabled Fast-Place-Vanilla {
    if module_enabled 10-CPS-AC {
        func doCrystal
    }
}
// aaaaaaaaaaaaaaaaaaaaaaaaaaaa

on module_enable while 0.025 module_enabled Auto-Crystal if playing if module_disabled Fast-Place-Vanilla {
    if module_enabled 20-CPS-AC {
       func doCrystal
    }
}

on module_enable while 0.033 module_enabled Auto-Crystal if playing if module_disabled Fast-Place-Vanilla {
    if module_enabled 15-CPS-AC {
        func doCrystal
    }
}

on module_enable while 0.05 module_enabled Auto-Crystal if playing if module_disabled Fast-Place-Vanilla {
    if module_enabled 10-CPS-AC {
        func doCrystal
    }
}

on pre_tick if playing if module_disabled Fast-Place-Vanilla if module_enabled On-DMG-Tick {
    func doCrystal
}

def func doCrystal {
    if module_enabled Switch-To-Crystal {
        if target_block :obsidian {
            if_not holding :end_crystal {
            
                if module_enabled On-Sword-AC {
                    if holding #_sword {
                        switch :end_crystal
                    }
                }

                if module_enabled On-Totem-AC {
                    if holding :totem_of_undying {
                        switch :end_crystal
                    }
                }
                
            }
        }

        if target_entity :end_crystal {
            if_not holding :end_crystal {
            
                if module_enabled On-Sword-AC {
                    if holding #_sword {
                        input key O
                    }
                }

                if module_enabled On-Totem-AC {
                    if holding :totem_of_undying {
                        input key O
                    }
                }
                
            }
        }

    }

    if module_disabled Fast-Place-Vanilla {
    if holding #crystal {
        if target_block #obsidian {

        if module_enabled On-DMG-Tick {
            as nearest_entity :player {

                if hurt_time >= 0 if hurt_time 0.00000000000001 if_not input_active key P if_not input_active key P if_not input_active key P {
                input key P
                }

            }
        }

        if_not input_active key P if module_disabled On-DMG-Tick {
            input key P
            }

        }

        if target_entity :end_crystal  {

        if module_enabled On-DMG-Tick {
            as nearest_entity :player {

                if hurt_time >= 0 if hurt_time <= 0.00000000000001 if_not input_active key O if_not input_active key O if_not input_active key O {
                input key O
                }

            }
        }

        if_not input_active key O if module_disabled On-DMG-Tick {
            input key O
                }

            }
        }
    }    

    if module_enabled Fast-Place-Vanilla {
        if holding :end_crystal {
            if target_entity :end_crystal {
                input key O
                }
            }
        }
    }    
