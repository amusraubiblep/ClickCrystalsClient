
def module Spear-Swap
def desc "Swaps to spear, attacks, then swaps back"

on module_enable if playing if_not input_active inventory if hotbar_has #spear {
    hold_input cancel
switch #spear
input left
wait 0.05 {
    if module_enabled Spear-Swap-Back {
    switch back
    module disable Spear-Swap
    module disable Spear-Swap-Keybind
     }
    }
}


